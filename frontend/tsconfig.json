{
    "compilerOptions": {
      "baseUrl": ".",
      "paths": {
        "@/*": ["*"],
        "@/config": ["./config"],
        "@types/*": ["./types/*"],
        "@components/*": ["./components/*"],
        "@app/*": ["./app/*"],
        "@utils/*": ["./utils/*"]
      }
    },

  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}